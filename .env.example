# 复制为 .env 后按需修改，全部可选

# 同时挂的游戏数上限（Steam 限制 32）
MAX_CONCURRENT=32

# 游玩时长达到多少小时后改为单独挂；设为 0 则始终逐个挂
HOURS_UNTIL_DROPS=2

# 检查徽章页的间隔（分钟，最小 5）
CHECK_INTERVAL_MINUTES=15

# 不挂的游戏 appid，逗号分隔
SKIP_APPIDS=

# 在线状态：online / invisible / offline
PERSONA_STATE=online

# 在 Steam 授权设备列表中显示的名称
MACHINE_NAME=steam-idler

# 容器运行用户，需对 ./data 有写权限
PUID=1000
PGID=1000
TZ=Asia/Shanghai
