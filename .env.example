# 复制为 .env 后按需修改，全部可选
# 挂卡参数在管理面板的“设置”页中配置，这里只有部署相关的选项

# 管理面板映射到宿主机的端口
WEB_PORT=8600

# 面板监听的宿主机地址：127.0.0.1 只允许本机访问（VPS + 反向代理）；
# 0.0.0.0 允许局域网/公网直接访问（NAS 内网使用）。Docker 发布的端口会绕过 ufw 等防火墙
WEB_BIND=127.0.0.1

# 部署在 Nginx / Caddy 等反向代理之后时设为 true，以获取真实客户端 IP（用于登录失败限制）
# true 只信任本机和内网来源的代理；也可填写代理的 IP/CIDR 列表，例如 172.18.0.1,10.0.0.0/8
TRUST_PROXY=false

# 容器运行用户，需对 ./data 有写权限
PUID=1000
PGID=1000
TZ=Asia/Shanghai
